# ========================================================
# Student Management System - Backend Environment Configuration
# Copy this file to .env or set these environment variables
# ========================================================

# MySQL Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Application Port
SERVER_PORT=8080

# CORS Allowed Origin (Default is Vite dev server)
CORS_ORIGIN=http://localhost:5173

# JWT Secret Key (HMAC-SHA256 requires minimum 256 bits / 32 bytes)
# Example generated 256-bit secret:
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
